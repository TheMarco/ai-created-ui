{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.ai-created.com/contracts/consumer-registry.schema.json",
  "title": "AI-Created UI consumer registry",
  "description": "Canonical inventory and versioned lifecycle contract for products that track reviewed @ai-created/ui releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "lifecycle", "consumers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "package": { "const": "@ai-created/ui" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|\\.\\./)" }
    },
    "lifecycleStageId": {
      "enum": [
        "release-published",
        "renovate-detection",
        "schedule-bypass",
        "update-pr",
        "validation",
        "manual-merge",
        "deployment",
        "currency-current"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "stageOrder", "stages"],
      "properties": {
        "version": { "const": "1.0.0" },
        "stageOrder": {
          "type": "array",
          "prefixItems": [
            { "const": "release-published" },
            { "const": "renovate-detection" },
            { "const": "schedule-bypass" },
            { "const": "update-pr" },
            { "const": "validation" },
            { "const": "manual-merge" },
            { "const": "deployment" },
            { "const": "currency-current" }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "stages": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/lifecycleStage" }
        }
      }
    },
    "lifecycleStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "automation", "description", "nextStage"],
      "properties": {
        "id": { "$ref": "#/$defs/lifecycleStageId" },
        "actor": {
          "enum": [
            "release-manager",
            "renovate",
            "maintainer",
            "github-actions",
            "deployment-provider"
          ]
        },
        "automation": { "enum": ["automatic", "manual", "conditional"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "nextStage": {
          "anyOf": [{ "$ref": "#/$defs/lifecycleStageId" }, { "type": "null" }]
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "defaultBranch",
        "manifestPath",
        "lockfilePath",
        "owner",
        "dependencyAutomation",
        "validation",
        "currency",
        "deployment"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "repository": { "$ref": "#/$defs/repository" },
        "defaultBranch": { "$ref": "#/$defs/nonEmptyString" },
        "manifestPath": { "$ref": "#/$defs/relativePath" },
        "lockfilePath": { "$ref": "#/$defs/relativePath" },
        "owner": { "type": "string", "minLength": 3 },
        "dependencyAutomation": { "$ref": "#/$defs/dependencyAutomation" },
        "validation": { "$ref": "#/$defs/validation" },
        "currency": { "$ref": "#/$defs/currency" },
        "deployment": { "$ref": "#/$defs/deployment" }
      }
    },
    "dependencyAutomation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "configPath",
        "dashboardIssue",
        "schedule",
        "rescan",
        "scheduleBypass",
        "pullRequest"
      ],
      "properties": {
        "provider": { "const": "renovate" },
        "configPath": { "$ref": "#/$defs/relativePath" },
        "dashboardIssue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timezone", "expression"],
          "properties": {
            "timezone": { "$ref": "#/$defs/nonEmptyString" },
            "expression": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "rescan": { "$ref": "#/$defs/manualDashboardAction" },
        "scheduleBypass": { "$ref": "#/$defs/manualDashboardAction" },
        "pullRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creator", "automerge", "labels"],
          "properties": {
            "creator": { "const": "renovate" },
            "automerge": { "const": false },
            "labels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "manualDashboardAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual", "method"],
      "properties": {
        "manual": { "const": true },
        "method": {
          "enum": [
            "dependency-dashboard-rescan-checkbox",
            "dependency-dashboard-release-checkbox"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "workflowPath",
        "workflowName",
        "trigger",
        "policyRequiredCheckName",
        "branchProtectionEnforced",
        "checks"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "workflowPath": { "$ref": "#/$defs/relativePath" },
        "workflowName": { "$ref": "#/$defs/nonEmptyString" },
        "trigger": { "const": "pull_request" },
        "policyRequiredCheckName": { "$ref": "#/$defs/nonEmptyString" },
        "branchProtectionEnforced": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "command": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "workflowPath",
        "cron",
        "timezone",
        "comparison",
        "staleBehavior"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "workflowPath": { "$ref": "#/$defs/relativePath" },
        "cron": { "$ref": "#/$defs/nonEmptyString" },
        "timezone": { "const": "UTC" },
        "comparison": { "const": "latest-github-release" },
        "staleBehavior": { "const": "fail-workflow" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postMergeVerification", "targets"],
      "properties": {
        "postMergeVerification": { "const": "all-targets-required" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deploymentTarget" }
        }
      }
    },
    "deploymentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "trigger", "verification"],
      "properties": {
        "id": { "enum": ["web", "worker"] },
        "provider": { "enum": ["vercel", "fly.io"] },
        "trigger": { "enum": ["push-to-main", "package-lock-or-manifest-push-to-main"] },
        "verification": {
          "oneOf": [
            { "$ref": "#/$defs/httpDeploymentVerification" },
            { "$ref": "#/$defs/workflowDeploymentVerification" }
          ]
        }
      }
    },
    "httpDeploymentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "const": "provider-deployment-and-http" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "workflowDeploymentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "workflowPath", "jobName", "application"],
      "properties": {
        "method": { "const": "github-actions-workflow" },
        "workflowPath": { "$ref": "#/$defs/relativePath" },
        "jobName": { "$ref": "#/$defs/nonEmptyString" },
        "application": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
