{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.ai-created.com/contracts/consumer-registry.schema.json",
  "title": "AI-Created UI consumer registry",
  "description": "Canonical inventory of supported products that must track reviewed @ai-created/ui releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "consumers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "package": { "const": "@ai-created/ui" },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    }
  },
  "$defs": {
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "defaultBranch",
        "manifestPath",
        "validationCommand",
        "owner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "manifestPath": { "type": "string", "minLength": 1 },
        "validationCommand": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 3 }
      }
    }
  }
}
