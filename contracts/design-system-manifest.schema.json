{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.ai-created.com/contracts/design-system-manifest.schema.json",
  "title": "AI-Created UI design-system manifest",
  "description": "Machine-readable component, guideline, asset, and validation contract for AI agents and other tooling.",
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "schemaVersion",
    "package",
    "canonicalSourcePrecedence",
    "artifacts",
    "publicApi",
    "components",
    "guidelines",
    "validation"
  ],
  "properties": {
    "$schema": { "const": "contracts/design-system-manifest.schema.json" },
    "manifestVersion": { "const": "1.0.0" },
    "schemaVersion": { "const": "1.0.0" },
    "package": {
      "type": "object",
      "required": ["name", "version", "sourcePath", "publicApiPath", "entrypoints"],
      "properties": {
        "name": { "const": "@ai-created/ui" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "publicApiPath": { "type": "string", "minLength": 1 },
        "entrypoints": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/entrypoint" }
        }
      },
      "additionalProperties": false
    },
    "canonicalSourcePrecedence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourcePrecedence" }
    },
    "artifacts": {
      "type": "object",
      "required": ["manifest", "tokens", "agentContext", "templates", "policy"],
      "properties": {
        "manifest": {
          "type": "object",
          "required": ["sourcePath", "repositoryPath", "publicPath", "schemaPath", "derived", "authority"],
          "properties": {
            "derived": { "const": true },
            "authority": { "type": "string", "minLength": 1 }
          }
        },
        "tokens": {
          "type": "object",
          "required": ["sourcePath", "repositoryPath", "publicPath", "format", "cssVariableCount"]
        },
        "agentContext": {
          "type": "object",
          "required": ["sourcePath", "conciseRepositoryPath", "concisePublicPath", "fullRepositoryPath", "fullPublicPath", "derived"],
          "properties": { "derived": { "const": true } },
          "additionalProperties": true
        },
        "templates": {
          "type": "object",
          "required": ["manifestPath", "schemaPath", "packagePath", "templateCount"],
          "properties": { "templateCount": { "const": 6 } },
          "additionalProperties": true
        },
        "policy": {
          "type": "object",
          "required": ["configPath", "schemaPath", "validatorPath"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "publicApi": {
      "type": "object",
      "required": ["sourcePath", "exports"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "exports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicExport" }
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/component" }
    },
    "guidelines": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/guideline" }
    },
    "validation": {
      "type": "object",
      "required": ["policy", "commands"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/validationCommand" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entrypoint": {
      "type": "object",
      "required": ["name", "target"],
      "properties": {
        "name": { "type": "string" },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sourcePrecedence": {
      "type": "object",
      "required": ["rank", "scope", "paths", "authority"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "publicExport": {
      "type": "object",
      "required": ["name", "localName", "kind", "modulePath", "sourcePath"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "localName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["value", "type"] },
        "modulePath": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "name",
        "category",
        "summary",
        "sourcePath",
        "packageExports",
        "designTokens",
        "implementation",
        "accessibilitySpec",
        "testing",
        "construction"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "pattern": "^src/" },
        "packageExports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "designTokens": { "type": "array", "minItems": 1 },
        "implementation": { "type": "object" },
        "accessibilitySpec": { "type": "object" },
        "testing": { "type": "object" },
        "construction": {
          "type": "object",
          "required": [
            "asset",
            "autoLayout",
            "resizing",
            "exposedProperties",
            "nestedAssets",
            "contentLimits",
            "localization",
            "responsive",
            "limitations",
            "governance"
          ],
          "properties": {
            "governance": {
              "type": "object",
              "required": ["status", "ownerRole", "lastReviewed", "canonicalSource", "changePolicy"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "guideline": {
      "type": "object",
      "required": [
        "slug",
        "index",
        "title",
        "summary",
        "status",
        "owner",
        "lastReviewed",
        "reviewCycle",
        "sourceOfTruth",
        "sourcePath",
        "outcomes",
        "sections"
      ],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    },
    "validationCommand": {
      "type": "object",
      "required": ["id", "command", "purpose", "blocking"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "blocking": { "const": true }
      },
      "additionalProperties": false
    }
  }
}
