{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "dependencyDashboard": true,
  "timezone": "America/Los_Angeles",
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "description": "Keep unrelated dependencies outside the design-system update workflow",
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "description": "Track reviewed @ai-created/ui SemVer tags",
      "matchManagers": ["npm"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["@ai-created/ui"],
      "matchPackageNames": ["TheMarco/ai-created-ui"],
      "versioning": "semver",
      "rangeStrategy": "pin",
      "separateMajorMinor": true,
      "automerge": false,
      "enabled": true,
      "labels": ["dependencies", "design-system"]
    }
  ]
}
