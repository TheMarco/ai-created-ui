{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Track @ai-created/ui immutable SemVer release tags",
      "matchManagers": ["npm"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["@ai-created/ui"],
      "matchPackageNames": ["TheMarco/ai-created-ui"],
      "versioning": "semver",
      "rangeStrategy": "pin",
      "separateMajorMinor": true,
      "automerge": false,
      "labels": ["dependencies", "design-system"]
    }
  ]
}
